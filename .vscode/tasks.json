{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Supabase CLI: Login",
      "type": "shell",
      "command": "npx",
      "args": ["supabase", "login"],
      "problemMatcher": []
    },
    {
      "label": "Supabase CLI: Run Migration",
      "type": "shell",
      "command": "npx",
      "args": ["supabase", "db", "push"],
      "options": {
        "cwd": "${workspaceFolder}/supabase"
      },
      "problemMatcher": []
    }
  ]
}
