{
  "name": "OIA - Progressive Orchestration Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "opportunity-pipeline",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const { userId, resumeText } = $input.first().json.body;\nreturn [{ json: { userId, resumeText } }];"
      },
      "id": "extract-params",
      "name": "Extract Parameters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "key", "value": "={{ $env.GEMINI_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "contents": [
            {
              "parts": [
                {
                  "text": "=Parse this resume into a structured JSON profile with fields: name, email, phone, experience_level, summary, preferred_domains, interests, skills, projects, experience. \n\nResume text:\n{{ $json.resumeText }}"
                }
              ]
            }
          ],
          "generationConfig": {
            "responseMimeType": "application/json"
          }
        },
        "options": {}
      },
      "id": "gemini-parse",
      "name": "Parse Resume (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst text = response.candidates[0].content.parts[0].text;\nlet profile;\ntry { profile = JSON.parse(text); } catch(e) { profile = {}; }\nreturn [{ json: { ...($('extract-params').first().json), profile } }];"
      },
      "id": "format-profile",
      "name": "Format Profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/opportunities",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "extraction_status", "value": "eq.complete" },
            { "name": "order", "value": "recommendation_score.desc" },
            { "name": "limit", "value": "20" }
          ]
        },
        "options": {}
      },
      "id": "fetch-opportunities",
      "name": "Search Opportunities (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "key", "value": "={{ $env.GEMINI_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "contents": [
            {
              "parts": [
                {
                  "text": "=Match the candidate profile against these opportunities. Return JSON array of objects with opportunityId, matchScore, matchExplanation, skillGap.\n\nProfile: {{ JSON.stringify($('format-profile').first().json.profile) }}\n\nOpportunities: {{ JSON.stringify($input.first().json) }}"
                }
              ]
            }
          ],
          "generationConfig": {
            "responseMimeType": "application/json"
          }
        },
        "options": {}
      },
      "id": "gemini-match",
      "name": "Match Scoring (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "key", "value": "={{ $env.GEMINI_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "contents": [
            {
              "parts": [
                {
                  "text": "=Generate a comprehensive career intelligence report (scores, strengths, skill gaps, 180-day plan) for this profile.\n\nProfile: {{ JSON.stringify($('format-profile').first().json.profile) }}"
                }
              ]
            }
          ],
          "generationConfig": {
            "responseMimeType": "application/json"
          }
        },
        "options": {}
      },
      "id": "gemini-strategy",
      "name": "Recommendation Generation (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "jsCode": "const matchRes = $('gemini-match').first().json;\nconst stratRes = $input.first().json;\n\nconst matchesText = matchRes.candidates[0].content.parts[0].text;\nconst stratText = stratRes.candidates[0].content.parts[0].text;\n\nlet matches, strategy;\ntry { matches = JSON.parse(matchesText); } catch(e) { matches = []; }\ntry { strategy = JSON.parse(stratText); } catch(e) { strategy = {}; }\n\nconst prevData = $('format-profile').first().json;\nconst dbPayload = {\n  user_id: prevData.userId,\n  opportunity_matches: matches,\n  ...strategy,\n  updated_at: new Date().toISOString()\n};\n\nreturn [{ json: dbPayload }];"
      },
      "id": "prepare-db",
      "name": "Prepare DB Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/oia_career_analysis",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ $json }}",
        "options": {}
      },
      "id": "save-db",
      "name": "Store Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Pipeline completed successfully\",\n  \"data\": {{ JSON.stringify($('prepare-db').first().json) }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook-response",
      "name": "Notify Frontend",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1800, 0]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Extract Parameters", "type": "main", "index": 0 }]]
    },
    "Extract Parameters": {
      "main": [[{ "node": "Parse Resume (Gemini)", "type": "main", "index": 0 }]]
    },
    "Parse Resume (Gemini)": {
      "main": [[{ "node": "Format Profile", "type": "main", "index": 0 }]]
    },
    "Format Profile": {
      "main": [[{ "node": "Search Opportunities (Supabase)", "type": "main", "index": 0 }]]
    },
    "Search Opportunities (Supabase)": {
      "main": [[{ "node": "Match Scoring (Gemini)", "type": "main", "index": 0 }]]
    },
    "Match Scoring (Gemini)": {
      "main": [[{ "node": "Recommendation Generation (Gemini)", "type": "main", "index": 0 }]]
    },
    "Recommendation Generation (Gemini)": {
      "main": [[{ "node": "Prepare DB Payload", "type": "main", "index": 0 }]]
    },
    "Prepare DB Payload": {
      "main": [[{ "node": "Store Results", "type": "main", "index": 0 }]]
    },
    "Store Results": {
      "main": [[{ "node": "Notify Frontend", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["OIA", "Progressive Workflow"],
  "triggerCount": 0,
  "updatedAt": "2026-06-02T00:00:00.000Z",
