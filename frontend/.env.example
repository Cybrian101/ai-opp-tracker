# Required: your Gemini API key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional but recommended: Upstash Redis (free tier) for per-IP rate limiting.
# Without these, rate limiting falls back to a best-effort in-memory counter
# that resets whenever the serverless function cold-starts.
# Create a free database at https://upstash.com and paste its REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many times a single IP address may run an analysis within the window below.
# Raise this (e.g. to 5) if your event is on shared WiFi where many attendees
# share one public IP.
RATE_LIMIT_MAX=1

# Rate limit window, in seconds. Default: 86400 (24 hours).
RATE_LIMIT_WINDOW_SECONDS=86400

# How many orchestrator module runs (Career DNA, JD Lab, etc.) one IP may do within the window.
# Raise it on shared event WiFi. Default: 40.
RATE_LIMIT_MODULE_MAX=40
