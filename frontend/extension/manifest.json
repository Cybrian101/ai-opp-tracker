{
  "manifest_version": 3,
  "name": "PathFound Job Copilot",
  "version": "0.1.0",
  "description": "Open any job page, application form or invitation and get an honest verdict: does it fit you, what is missing, and is it safe to apply?",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": ["http://localhost:3001/*"],
  "action": {
    "default_title": "Analyse this page with PathFound",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
